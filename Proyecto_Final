#include <Arduino.h>
#include <WiFi.h>
#include <DHT.h>
#include <Firebase_ESP_Client.h>

// WIFI 
#define WIFI_SSID "INFINITUMB09F_2.4"
#define WIFI_PASSWORD "Um7h7DgFgR"

// FIREBASE 
#define API_KEY "AIzaSyBLtXDaBpxVMOY2imEvasPsDK_laKaZJDg"
#define DATABASE_URL "https://proyectortos-default-rtdb.firebaseio.com/"

// DEFINICION
#define DHTPIN 13
#define DHTTYPE DHT22

#define PIN_PTC 14
#define PIN_FAN 15

#define SETPOINT_TEMP 45.0
#define HISTERESIS 1.0

// OBJETOS 
DHT dht(DHTPIN, DHTTYPE);

FirebaseData fbdo;
FirebaseAuth auth;
FirebaseConfig config;

SemaphoreHandle_t mutexSensor;

// VARIABLES GLOBALES 
float temperatura = 0.0;
float humedad = 0.0;

// TAREAS
TaskHandle_t taskSensorHandle;
TaskHandle_t taskControlTempHandle;
TaskHandle_t taskFanHandle;

// TAREA 1: SENSOR 
void tareaSensor(void *pvParameters) {
  while (1) {
    float t = dht.readTemperature();
    float h = dht.readHumidity();

    if (!isnan(t) && !isnan(h)) {

      if (xSemaphoreTake(mutexSensor, portMAX_DELAY)) {
        temperatura = t;
        humedad = h;
        xSemaphoreGive(mutexSensor);
      }

      Serial.print("Temperatura: ");
      Serial.print(t);
      Serial.print(" °C | Humedad: ");
      Serial.print(h);
      Serial.println(" %");

      // Enviar a Firebase
      Firebase.RTDB.setFloat(&fbdo, "/secadora/temperatura", t);
      Firebase.RTDB.setFloat(&fbdo, "/secadora/humedad", h);

    } else {
      Serial.println("Error al leer DHT22");
    }

    vTaskDelay(pdMS_TO_TICKS(2000));  // Tiempo recomendado DHT22
  }
}

// TAREA 2: CONTROL DEL CALENTADOR
void tareaControlTemp(void *pvParameters) {
  while (1) {
    float tempActual;

    if (xSemaphoreTake(mutexSensor, portMAX_DELAY)) {
      tempActual = temperatura;
      xSemaphoreGive(mutexSensor);
    }

    if (tempActual < (SETPOINT_TEMP - HISTERESIS)) {
      digitalWrite(PIN_PTC, HIGH);
    } 
    else if (tempActual > (SETPOINT_TEMP + HISTERESIS)) {
      digitalWrite(PIN_PTC, LOW);
    }

    vTaskDelay(pdMS_TO_TICKS(500));
  }
}

// TAREA 3: VENTILADOR
void tareaVentilador(void *pvParameters) {
  digitalWrite(PIN_FAN, HIGH);  // Ventilador siempre encendido
  while (1) {
    vTaskDelay(pdMS_TO_TICKS(1000));
  }
}

// 
void setup() {
  Serial.begin(115200);
  dht.begin();

  pinMode(PIN_PTC, OUTPUT);
  pinMode(PIN_FAN, OUTPUT);

  digitalWrite(PIN_PTC, LOW);
  digitalWrite(PIN_FAN, LOW);

  mutexSensor = xSemaphoreCreateMutex();

  // WIFI 
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("Conectando a WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    Serial.print(".");
    delay(500);
  }
  Serial.println("\nWiFi conectado");

  // FIREBASE
  config.api_key = API_KEY;
  config.database_url = DATABASE_URL;
  Firebase.begin(&config, &auth);
  Firebase.reconnectWiFi(true);

  // TAREAS 
  xTaskCreatePinnedToCore(
    tareaSensor, "Sensor", 4096, NULL, 1, &taskSensorHandle, 1
  );

  xTaskCreatePinnedToCore(
    tareaControlTemp, "ControlTemp", 4096, NULL, 2, &taskControlTempHandle, 1
  );

  xTaskCreatePinnedToCore(
    tareaVentilador, "Ventilador", 2048, NULL, 1, &taskFanHandle, 1
  );
}

